version "1.1.0"
// Evaluation-time fetching lets the shipped resolver supply sources without IFD.
inputs {
    nixpkgs {
        archive fetch-time=eval {
            url "https://github.com/NixOS/nixpkgs/archive/{{fresh_value}}.tar.gz"
        }
        hash algorithm=SHA-256
        fresh-cmd {
            $ echo "2efa67fd26b6df417c33e4603185c701f260dd83"
        }
    }
    patchelf {
        archive fetch-time=eval {
            url "https://github.com/NixOS/patchelf/archive/{{fresh_value}}.tar.gz"
        }
        hash algorithm=SHA-256
        fresh-cmd {
            $ echo "3e996dbef1fa0658012f8dd290bddcf0302acade"
        }
    }
    flake-compat {
        archive fetch-time=eval {
            url "https://github.com/NixOS/flake-compat/archive/{{fresh_value}}.tar.gz"
        }
        hash algorithm=SHA-256
        fresh-cmd {
            $ echo "5edf11c44bc78a0d334f6334cdaf7d60d732daab"
        }
    }
}
