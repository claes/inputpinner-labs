version "1.1.0"
inputs {
    nixpkgs {
        archive fetch-time=build {
            url "https://github.com/NixOS/nixpkgs/archive/{{fresh_value}}.tar.gz"
        }
        hash algorithm=SHA-256
        fresh-cmd {
            $ echo "2efa67fd26b6df417c33e4603185c701f260dd83"
        }
    }
    patchelf {
        archive fetch-time=build {
            url "https://github.com/NixOS/patchelf/archive/{{fresh_value}}.tar.gz"
        }
        hash algorithm=SHA-256
        fresh-cmd {
            $ echo "3e996dbef1fa0658012f8dd290bddcf0302acade"
        }
    }
    with-inputs {
        archive fetch-time=build {
            url "https://github.com/denful/with-inputs/archive/{{fresh_value}}.tar.gz"
        }
        hash algorithm=SHA-256
        fresh-cmd {
            $ echo "641d01ef95eae1aeaa257ffd48102ab9a308f2a2"
        }
    }
    flake-parts {
        archive fetch-time=build {
            url "https://github.com/hercules-ci/flake-parts/archive/{{fresh_value}}.tar.gz"
        }
        hash algorithm=SHA-256
        fresh-cmd {
            $ echo "205b12d8b7cd4802fbcb8e8ef6a0f1408781a4f9"
        }
    }
    git-hooks-nix {
        archive fetch-time=build {
            url "https://github.com/cachix/git-hooks.nix/archive/{{fresh_value}}.tar.gz"
        }
        hash algorithm=SHA-256
        fresh-cmd {
            $ echo "aa9f40c906904ebd83da78e7f328cd8aeaeae785"
        }
    }
    upstream-nixpkgs {
        archive fetch-time=build {
            url "https://github.com/NixOS/nixpkgs/archive/{{fresh_value}}.tar.gz"
        }
        hash algorithm=SHA-256
        fresh-cmd {
            $ echo "c69a9bffbecde46b4b939465422ddc59493d3e4d"
        }
    }
}
